# Graph backend selection
GRAPH_BACKEND=hana  # or "networkx" for local dev

# NetworkX backend (local CSV mode)
CSV_DIR=../procurement-data-generator/output/csv

# HANA Cloud
HANA_HOST=
HANA_PORT=443
HANA_USER=DBADMIN
HANA_PASSWORD=
HANA_SCHEMA=PROCUREMENT

# JWT Auth (for local dev; in prod use XSUAA)
JWT_SECRET=your-dev-secret-key
# Skip auth for development (set to true to bypass JWT validation)
SKIP_AUTH=false
